# App registration del FRONTEND (SPA) en Entra ID
VITE_AZURE_CLIENT_ID=<client-id del Frontend>
VITE_AZURE_TENANT_ID=<tenant-id>
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# API Gateway (sin slash final). Los paths /api/orders y /api/catalog se agregan en el código
VITE_API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com

# Identidad del BACKEND. Se le agregan orders.read, orders.write, catalog.read y catalog.write
VITE_API_SCOPE_BASE=api://<client-id del Backend>